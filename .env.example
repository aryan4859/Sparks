# Copy to .env and fill in. On Vercel, add the same keys under
# Project → Settings → Environment Variables.

# ─── Supabase (Dashboard → Project Settings → API) ──────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Only for the npm scripts (create-admin, import-osm). Never expose it to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# ─── Public address of the site ─────────────────────────────────────────────
# Used for email links, the sitemap and social previews. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# ─── Newsletter via the Gmail API (see scripts/gmail-auth.mjs) ──────────────
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / GOOGLE_REFRESH_TOKEN also work.
GMAIL_CLIENT_ID=...apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-...
GMAIL_REFRESH_TOKEN=1//...
NEWSLETTER_FROM="Sparks <you@gmail.com>"
